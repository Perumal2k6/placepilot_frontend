# Environment variables for Placement Preparation Portal

# The base URL of the FastAPI backend.
# In local development, this is typically http://localhost:8000/api/v1
# In production, this should point to your deployed backend.
# NOTE: Variables prefixed with VITE_ are exposed to the client-side code.
# DO NOT place actual secrets, passwords, database URLs, or private keys here!

VITE_API_BASE_URL=http://localhost:8000/api/v1
